--- /dev/null
+++ b/src/scripts/test-brand.ts
@@ -0,0 +1,38 @@
+export function mountTestBrand() {
+  const svg = document.querySelector<SVGSVGElement>('[data-test-brand]');
+  const header = document.querySelector<HTMLElement>('[data-intro-header]');
+  if (!svg || !header) return;
+  const dot = svg.querySelector<SVGGElement>('[data-letter="i-o"]')!;
+  const suffix = Array.from(svg.querySelectorAll<SVGGElement>('[data-letter]')).filter(el => !['T', 'i-o'].includes(el.dataset.letter!));
+  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
+  let current = 0, target = 0, frame = 0, last = 0;
+  const ease = (p: number) => p * p * p * (p * (p * 6 - 15) + 10);
+  function paint() {
+    const p = ease(current), q = Math.min(1, current / .78);
+    // The supplied first letter already is the compact tau mark. Preserve its
+    // exact outline and carry the supplied teal dot above it on one soft arc.
+    dot.setAttribute('transform', `translate(${-1254.14 * p} ${-86.67 * p - 120 * Math.sin(Math.PI * p)})`);
+    suffix.forEach(el => { el.setAttribute('opacity', String(1 - ease(q))); el.setAttribute('transform', `translate(${-70 * p} 0)`); });
+    svg!.dataset.progress = current.toFixed(4);
+  }
+  function tick(now: number) {
+    const dt = Math.min(64, Math.max(1, now - last)); last = now;
+    current += (target - current) * (1 - Math.exp(-dt / 90));
+    if (Math.abs(current - target) < .0002) current = target;
+    paint(); frame = current === target ? 0 : requestAnimationFrame(tick);
+  }
+  function schedule() {
+    target = Math.max(0, Math.min(1, (scrollY - 16) / 240));
+    header!.toggleAttribute('data-scrolled', scrollY > 8);
+    if (reduced.matches) { cancelAnimationFrame(frame); frame = 0; current = target; paint(); }
+    else if (!frame) { last = performance.now(); frame = requestAnimationFrame(tick); }
+  }
+  schedule(); paint();
+  addEventListener('scroll', schedule, { passive: true });
+  addEventListener('pageshow', schedule); reduced.addEventListener('change', schedule);
+  addEventListener('pagehide', (event: PageTransitionEvent) => {
+    cancelAnimationFrame(frame); frame = 0;
+    if (event.persisted) return;
+    removeEventListener('scroll', schedule); removeEventListener('pageshow', schedule); reduced.removeEventListener('change', schedule);
+  });
+}
diff --git a/src/scripts/test-theme.ts b/src/scripts/test-theme.ts
new file mode 100644
index 0000000..837b4c8
--- /dev/null
+++ b/src/scripts/test-theme.ts
@@ -0,0 +1,30 @@
+export function mountTestTheme() {
+  const root = document.documentElement, toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
+  if (!toggle) return;
+  const media = matchMedia('(prefers-color-scheme: dark)');
+  let manual = new URLSearchParams(location.search).has('theme');
+  try { manual ||= !!localStorage.getItem('telotia-demo-theme'); } catch {}
+  function label() {
+    const dark = root.dataset.theme === 'dark', fr = root.lang.startsWith('fr');
+    toggle!.textContent = dark ? fr ? 'Clair' : 'Light' : fr ? 'Sombre' : 'Dark';
+    toggle!.setAttribute('aria-label', fr ? `Activer le mode ${dark ? 'clair' : 'sombre'}` : `Switch to ${dark ? 'light' : 'dark'} mode`);
+    toggle!.setAttribute('aria-pressed', String(dark));
+  }
+  function set(theme: string) {
+    root.dataset.theme = theme;
+    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#101C26' : '#F8F6F2');
+    document.querySelector('[data-theme-icon]')?.setAttribute('href', `/assets/resource-intro/brand/test-mark-${theme}.svg`);
+    document.dispatchEvent(new CustomEvent('resource-theme')); label();
+  }
+  toggle.addEventListener('click', () => {
+    manual = true; const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    try { localStorage.setItem('telotia-demo-theme', theme); } catch {}
+    // Explicit query choices are shareable; a later toggle updates them too.
+    const url = new URL(location.href);
+    if (url.searchParams.has('theme')) { url.searchParams.set('theme', theme); history.replaceState(null, '', url); }
+    set(theme);
+  });
+  media.addEventListener('change', () => { if (!manual) set(media.matches ? 'dark' : 'light'); });
+  document.addEventListener('resource-language', label);
+  set(root.dataset.theme || 'light');
+}
