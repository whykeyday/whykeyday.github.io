+    const state = testBrandState(current);
+    dot.setAttribute('transform', `translate(${state.x} ${state.y})`);
+    original.setAttribute('opacity', String(1 - state.hook));
+    hook.setAttribute('opacity', String(state.hook));
+    suffix.forEach(el => { el.setAttribute('opacity', String(state.suffix)); el.setAttribute('transform', `translate(${-70 * ease(current)} 0)`); });
