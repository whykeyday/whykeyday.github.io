+export function mountTestBrand() {
+  const svg = document.querySelector<SVGSVGElement>('[data-test-brand]');
+  const header = document.querySelector<HTMLElement>('[data-intro-header]');
+  if (!svg || !header) return;
+  const dot = svg.querySelector<SVGGElement>('[data-letter="i-o"]')!;
+  const original = svg.querySelector<SVGGElement>('[data-letter="T"]')!;
+  const hook = svg.querySelector<SVGGElement>('[data-brand-hook]')!;
+  const suffix = Array.from(svg.querySelectorAll<SVGGElement>('[data-letter]')).filter(el => !['T', 'i-o'].includes(el.dataset.letter!));
