+---
+import type { testWords } from '../../data/resource-test';
+interface Props { copy: typeof testWords.en; }
+const { copy } = Astro.props;
+const principles = [
+  ['clarityTitle', 'clarityBody', 'icon-clarity'],
+  ['connectionPrincipleTitle', 'connectionPrincipleBody', 'icon-connection'],
+  ['judgmentTitle', 'judgmentBody', 'icon-judgment'],
+] as const;
+---
+<div class="company-sections" data-company-sections>
+  <section id="products" class="company-section company-products" aria-labelledby="products-title">
+    <h2 id="products-title" class="company-title" data-copy="productsTitle">{copy.productsTitle}</h2>
+    <div class="product-stack">
+      <article class="product-card product-card-first" aria-labelledby="product-one-title">
+        <div class="product-card-copy"><span class="product-status" data-copy="productStatus">{copy.productStatus}</span><h3 id="product-one-title" data-copy="productOne">{copy.productOne}</h3><p data-copy="productSoon">{copy.productSoon}</p></div>
+        <span class="product-index" aria-hidden="true">01 / 02</span>
+      </article>
+      <article class="product-card product-card-second" aria-labelledby="product-two-title">
+        <div class="product-card-copy"><span class="product-status" data-copy="productNext">{copy.productNext}</span><h3 id="product-two-title" data-copy="productTwo">{copy.productTwo}</h3><p data-copy="productSoon">{copy.productSoon}</p></div>
+        <span class="product-index" aria-hidden="true">02 / 02</span>
+      </article>
+    </div>
+  </section>
+
+  <section id="about" class="company-intro company-section" aria-labelledby="company-title">
+    <div class="company-intro-copy" data-reveal>
+      <p class="company-label" data-copy="companyLabel">{copy.companyLabel}</p>
+      <h2 id="company-title" class="company-title" data-copy="companyStatement">{copy.companyStatement}</h2>
+      <p class="company-lead" data-copy="companyIntro">{copy.companyIntro}</p>
+      <p class="company-body" data-copy="companyBody">{copy.companyBody}</p>
+    </div>
+    <div class="ink-landscape" data-ink-window>
+      <img src="/assets/resource-intro/editorial/care-connections-abstract.png" width="1881" height="836" alt={copy.landscapeAlt} data-alt="landscapeAlt" loading="lazy" decoding="async" />
+    </div>
+  </section>
