+<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" aria-pressed="false">Dark</button>
+<script>
+  import { mountTestTheme } from '../../scripts/test-theme';
+  mountTestTheme();
+</script>
+<style is:global>
+  html[data-demo-variant='test'] { color-scheme:light; --motion-ink:#00757C; --surface:#FFFFFF; --surface-alt:#F2F0EA; --header-bg:#F8F6F2; --header-scroll:rgb(255 255 255 / .552); --cta:#245366; --cta-ink:#FFFFFF; --cta-hover:#262B31; }
+  html[data-demo-variant='test'][data-theme='dark'] {
+    color-scheme:dark; --bg:#101C26; --text:#F7F9F8; --text-secondary:#B7C6CF;
+    --navy:#D6E6EF; --teal:#56D5C9; --border:#3A4D59;
+    --surface:#172934; --surface-alt:#1D323F; --motion-ink:#56D5C9;
+    --header-bg:#101C26; --header-scroll:rgb(16 28 38 / .78);
+    --cta:#56D5C9; --cta-ink:#101C26; --cta-hover:#8EE8DE;
+    scrollbar-color:#B7C6CF var(--bg);
+  }
+  html[data-demo-variant='test'] .header-controls { display:flex; align-items:center; gap:12px; }
+  html[data-demo-variant='test'] .theme-toggle { background:transparent; border:1px solid var(--border); border-radius:8px; color:var(--navy); min-height:44px; min-width:52px; padding:0 8px; font:500 12px 'Inter',sans-serif; cursor:pointer; }
+  html[data-demo-variant='test'] .theme-toggle:hover { background:var(--surface-alt); border-color:var(--teal); }
+  html[data-page='pharmacy-intro'][data-demo-variant='test'] .site-header { background-color:var(--header-bg); }
