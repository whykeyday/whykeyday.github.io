+export function mountCompanyExperience() {
+  const root = document.documentElement;
+  if (root.dataset.demoVariant !== 'test' || !document.querySelector('[data-company-sections]')) return;
+  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
+  const hero = document.querySelector<HTMLElement>('#hero-title')!;
+  const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
+  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
+  const sections = ['home', 'products', 'about', 'approach'].map(id => document.getElementById(id)!);
+  let animations: Animation[] = [], frame = 0;
+  const observer = new IntersectionObserver(entries => {
+    entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } });
+  }, { threshold:.08, rootMargin:'0px 0px -24px 0px' });
+  function revealPreference() {
+    if (reduced.matches) { root.classList.remove('company-motion-ready'); reveals.forEach(el => el.classList.add('is-visible')); }
+    else { reveals.forEach(el => { if (!el.classList.contains('is-visible')) observer.observe(el); }); root.classList.add('company-motion-ready'); }
+  }
+  function headline(animate = false) {
+    const value = hero.textContent || '';
+    animations.forEach(animation => animation.cancel()); animations = [];
+    hero.setAttribute('aria-label', value.replace(/\s+/g, ' '));
+    hero.replaceChildren(...value.split('\n').map((text, index) => {
+      const mask = document.createElement('span'), ink = document.createElement('span');
+      mask.className = 'hero-line-mask'; mask.setAttribute('aria-hidden', 'true'); ink.className = 'hero-line'; ink.textContent = text; mask.append(ink);
+      if (animate && !reduced.matches && (!location.hash || location.hash === '#home')) animations.push(ink.animate([
+        { transform:'translateY(105%)', opacity:.35 }, { transform:'translateY(0)', opacity:1 },
+      ], { duration:760, delay:index * 90, easing:'cubic-bezier(.16,1,.3,1)', fill:'backwards' }));
+      return mask;
+    }));
+  }
+  function updateNav() {
+    frame = 0; let active = 'home';
+    sections.forEach(section => { if (section.getBoundingClientRect().top <= innerHeight * .38) active = section.id; });
+    links.forEach(link => { if (link.dataset.sectionLink === active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
+  }
+  function schedule() { if (!frame && !document.hidden) frame = requestAnimationFrame(updateNav); }
+  function languageChanged() { headline(); schedule(); }
+  function preferenceChanged() { animations.forEach(animation => animation.cancel()); revealPreference(); }
+  headline(true); revealPreference(); schedule();
+  addEventListener('scroll', schedule, { passive:true }); addEventListener('resize', schedule);
+  document.addEventListener('resource-language', languageChanged); reduced.addEventListener('change', preferenceChanged);
+  addEventListener('pagehide', (event: PageTransitionEvent) => {
+    cancelAnimationFrame(frame); frame = 0;
+    if (event.persisted) return;
+    observer.disconnect(); animations.forEach(animation => animation.cancel());
+    removeEventListener('scroll', schedule); removeEventListener('resize', schedule);
+    document.removeEventListener('resource-language', languageChanged); reduced.removeEventListener('change', preferenceChanged);
+  });
+}
