new file mode 100644
index 0000000..9e85241
--- /dev/null
+++ b/src/components/resource/TestBrand.astro
@@ -0,0 +1,21 @@
+---
+// Native vector companion of the supplied scale1/2/3 light and dark PNGs.
+// Both supplied SVGs have identical outlines, so currentColor preserves each
+// exact approved palette while letting the same mark move continuously.
+import supplied from '../../../public/assets/resource-intro/brand/telotia-light.svg?raw';
+import geometry from '../../data/telotia-brand.json';
+const markup = supplied.slice(supplied.indexOf('<svg'))
+  .replace('<svg ', '<svg class="test-brand" data-test-brand aria-hidden="true" focusable="false" ')
+  .replaceAll('fill="#282d32"', 'fill="currentColor"')
+  .replaceAll('id="', 'data-letter="')
+  .replace('</svg>', `<g data-brand-hook opacity="0" transform="translate(75 79) scale(1.85) translate(-480 -626)"><path d="${geometry.sourceBar}" fill="currentColor"/><path d="${geometry.sourceStem}" fill="currentColor"/></g></svg>`);
+---
+<Fragment set:html={markup} />
+<script>
+  import { mountTestBrand } from '../../scripts/test-brand';
+  mountTestBrand();
+</script>
+<style is:global>
+  .test-brand { display:block; width:100%; height:auto; overflow:visible; color:#282D32; opacity:1; }
+  html[data-theme='dark'] .test-brand { color:#F7F9F8; }
+</style>
diff --git a/src/components/resource/TestCompanySections.astro b/src/components/resource/TestCompanySections.astro
